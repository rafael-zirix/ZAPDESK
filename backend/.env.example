# Ambiente
ENV=dev
PORT=8080

# Banco
DATABASE_URL=postgres://zapdesk:zapdesk@localhost:5432/zapdesk?sslmode=disable

# Segurança (gere um segredo forte em produção)
JWT_SECRET=

# Meta WhatsApp — credenciais GLOBAIS do app de plataforma. O número de cada
# cliente vem da tabela whatsapp_accounts (fase de multi-número).
META_APP_SECRET=
META_VERIFY_TOKEN=
META_API_BASE_URL=https://graph.facebook.com/v20.0

# Resend (OTP por e-mail)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
