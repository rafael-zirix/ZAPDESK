# ─── HotZap / ZAPDESK — variáveis de ambiente ────────────────────────────────
# Copie para .env e preencha. As marcadas [BOOT] são checadas por Config.Validate()
# e a API RECUSA SUBIR sem elas — é de propósito: rodar sem chave de assinatura ou
# sem cifra é pior do que não rodar.

# ── Obrigatórias ────────────────────────────────────────────────────────────
ENV=dev                              # [BOOT] exatamente "dev" ou "prd"
PORT=8080
DATABASE_URL=postgres://zapdesk:zapdesk@localhost:5432/zapdesk?sslmode=disable
JWT_SECRET=                          # [BOOT] mínimo 32 caracteres — assina as sessões
ENCRYPTION_KEY=                      # [BOOT] 32 bytes em hex — cifra os tokens da Meta
                                     #        gere com: openssl rand -hex 32

# ── Endereço público e front ────────────────────────────────────────────────
PUBLIC_URL=                          # ex.: https://hotzap.com.br — entra na allowlist do
                                     # CORS e no webhook gravado na Meta
CORS_ORIGINS=                        # opcional: outras origens do painel, separadas por vírgula
WEB_DIR=                             # pasta do build Flutter; vazio = não serve o front
MEDIA_DIR=/app/media                 # onde ficam os anexos

# ── Meta / WhatsApp ─────────────────────────────────────────────────────────
META_APP_SECRET=                     # valida a assinatura do webhook (sem ele, TUDO é recusado)
META_VERIFY_TOKEN=                   # handshake de verificação do webhook
META_API_BASE_URL=https://graph.facebook.com/v20.0
META_APP_ID=                         # Embedded Signup + login do Instagram
META_ES_CONFIG_ID=                   # config do Embedded Signup (WhatsApp)
META_IG_CONFIG_ID=                   # config do Login para Empresas (Instagram)
META_TOKEN=                          # legado: número único de teste
META_PHONE_NUMBER_ID=                # legado: número único de teste
META_DEFAULT_ACCOUNT_ID=             # conta que recebe mensagens sem dono resolvido

# ── Login por código (OTP) ──────────────────────────────────────────────────
AUTH_OTP_ACCOUNT_ID=                 # conta cujo número envia os códigos por WhatsApp
AUTH_OTP_TEMPLATE=login_code
AUTH_OTP_LANG=pt_BR
RESEND_API_KEY=                      # canal reserva por e-mail
RESEND_FROM_EMAIL=
# Sem NENHUM canal disponível, o login falha em produção em vez de logar o código.

# ── Atendente IA (qualquer API compatível com OpenAI) ───────────────────────
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=                            # padrão da plataforma; cada conta pode escolher outro

# ── Cobrança ────────────────────────────────────────────────────────────────
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_ACCESS_TOKEN=            # PIX, checkout e assinatura
STRIPE_SECRET_KEY=                   # só recarga automática no cartão
STRIPE_WEBHOOK_SECRET=               # obrigatório se STRIPE_SECRET_KEY estiver preenchida:
                                     # sem ele o webhook do Stripe recusa tudo
NUPAY_BASE_URL=https://sandbox-api.spinpay.com.br
NUPAY_MERCHANT_KEY=                  # legado, dormente
NUPAY_MERCHANT_TOKEN=

# ── Auto-cadastro e retenção ────────────────────────────────────────────────
SIGNUP_TRIAL_TOKENS=50000            # crédito de boas-vindas (0 desliga)
SIGNUP_TRIAL_MODULE_DAYS=14          # dias de teste dos módulos (0 = só o núcleo)
RETENTION_ENABLED=                   # true liga a limpeza de histórico pelo plano
